# Copy to .env and adjust. crimson-headless-passkey reads ./.env automatically
# (or the file given with --env-file). Real environment variables win.
# Only CRIMSON_HEADLESS_PASSKEY_* keys are used. Keep .env out of git: it is
# already in .gitignore.

# Okta sign-in page, its WebAuthn relying-party ID, and the hosts that count as
# "still signing in". The defaults below are Harvard's (HarvardKey).
CRIMSON_HEADLESS_PASSKEY_URL=https://login.harvard.edu
CRIMSON_HEADLESS_PASSKEY_RP_ID=login.harvard.edu
CRIMSON_HEADLESS_PASSKEY_IDP_HOSTS=login.harvard.edu,harvard.okta.com

# Answer for Okta's username prompt when the saved session has expired.
# CRIMSON_HEADLESS_PASSKEY_USERNAME=you@example.edu

# Microsoft account picker (loginfmt) on the way to SharePoint / OneDrive.
# Defaults to the username above. "Stay signed in?" is always answered No.
# CRIMSON_HEADLESS_PASSKEY_UPN=you@harvard.edu

# Where the private key and saved session are kept.
#   keychain  the OS keychain, nothing secret on disk (default on macOS)
#   file      0600 files in the data directory (default elsewhere)
#
# WARNING: "file" is deliberately possible, but it is NOT the default, for
# security reasons. It writes the passkey's private key and live session
# cookies to disk, where a backup, a sync folder or a stolen disk can leak
# them. Use it only for fully hands-off runs where nobody is logged in to
# unlock a keychain (servers, CI). See SECURITY.md, "Where the Secrets Live".
# CRIMSON_HEADLESS_PASSKEY_SECRET_STORE=keychain

# Where the data files live (keep it local, outside any repo or synced folder).
# CRIMSON_HEADLESS_PASSKEY_HOME=~/.local/share/crimson-headless-passkey
